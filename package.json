{
  "name": "kernel-keep",
  "version": "0.3.0",
  "private": true,
  "description": "Kernel Keep (provisional title) — offline single-player fortress RTS prototype in a luminous digital world.",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --import tsx --test tests/*.test.ts",
    "econ": "tsx tools/econ_sim.ts",
    "bench": "tsx tools/bench.ts",
    "e2e": "node --import tsx e2e/e2e.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run e2e",
    "aivai": "tsx tools/aivai.ts",
    "serve": "node tools/serve.mjs",
    "fairness": "tsx tools/fairness.ts",
    "e2e:pwa": "node e2e/pwa-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "playwright": "1.56.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
